# Multi-stage build for production-grade region router
FROM golang:1.21-alpine AS builder

RUN apk add --no-cache git make gcc musl-dev

WORKDIR /build

COPY region-router/ ./

RUN go mod download
RUN go mod verify

RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build \
    -ldflags='-w -s -extldflags "-static"' \
    -a -installsuffix cgo \
    -o region-router \
    ./cmd/router

FROM alpine:3.18

RUN apk add --no-cache ca-certificates tzdata wget

WORKDIR /app

COPY --from=builder /build/region-router /app/region-router

RUN addgroup -g 1000 router && \
    adduser -D -u 1000 -G router router && \
    chown -R router:router /app

USER router

EXPOSE 8000 50050

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:8000/health || exit 1

ENTRYPOINT ["/app/region-router"]
