# =============================================================================
# AeroPhoenix Phoenix UI - Release Environment Configuration
# =============================================================================
# This file is executed at runtime when the release starts.
# Use it to set environment-specific configurations.
# =============================================================================

# Erlang VM configuration for fast startup (important for suspend/resume)
export ERL_AFLAGS="-proto_dist inet6_tcp"

# Memory settings optimized for suspend mode
# Keep the VM lean for faster suspend/resume
export ELIXIR_ERL_OPTIONS="+sbwt none +sbwtdcpu none +sbwtdio none"

# Garbage collection settings for low memory footprint
export ERL_FLAGS="+hms 233 +hmbs 233"

# Cookie for distributed Erlang (required for clustering)
if [ -z "${RELEASE_COOKIE:-}" ]; then
  export RELEASE_COOKIE="aerophoenix_phoenix_ui_cookie_${FLY_APP_NAME:-local}"
fi

# Node name for clustering
if [ -z "${RELEASE_NODE:-}" ]; then
  export RELEASE_NODE="phoenix_ui@${FLY_ALLOC_ID:-127.0.0.1}.vm.${FLY_APP_NAME:-phoenix_ui}.internal"
fi

# Distribution mode
export RELEASE_DISTRIBUTION="${RELEASE_DISTRIBUTION:-name}"

# Ensure IPv6 support (Fly.io uses IPv6 internally)
export ECTO_IPV6="true"
