<div
  class="min-h-screen bg-deep font-sans text-slate-300 relative overflow-hidden selection:bg-cyan-500/30 selection:text-cyan-200"
  phx-hook="MicroInteractions"
  id="micro-interactions"
>
  <!-- Error Banner (if any) -->
  <%= if @error do %>
    <div class="fixed top-4 left-1/2 transform -translate-x-1/2 z-[100] max-w-2xl w-full mx-4">
      <div class="bg-red-500/10 border border-red-500/50 rounded-lg p-4 backdrop-blur-xl shadow-2xl">
        <div class="flex items-center gap-3">
          <div class="flex-shrink-0">
            <svg
              class="w-6 h-6 text-red-400"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
              />
            </svg>
          </div>
          <div class="flex-1">
            <h3 class="text-red-400 font-semibold">Dashboard Error</h3>
            <p class="text-red-300/80 text-sm mt-1">{@error}</p>
          </div>
          <button phx-click="dismiss_error" class="flex-shrink-0 text-red-400 hover:text-red-300">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M6 18L18 6M6 6l12 12"
              />
            </svg>
          </button>
        </div>
      </div>
    </div>
  <% end %>
  
<!-- Cinematic Background Elements -->
  <div class="fixed inset-0 pointer-events-none z-0">
    <div class="absolute inset-0 bg-[url('/images/grid.svg')] opacity-[0.03]"></div>
    <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-transparent via-cyan-500/50 to-transparent opacity-50">
    </div>
    
<!-- Animated Orbs -->
    <div class="absolute top-[-10%] left-[-10%] w-[40%] h-[40%] rounded-full bg-violet-900/10 blur-[100px] animate-float">
    </div>
    <div class="absolute bottom-[-10%] right-[-10%] w-[40%] h-[40%] rounded-full bg-cyan-900/10 blur-[100px] animate-float animation-delay-2000">
    </div>
  </div>
  
<!-- Scanline Overlay -->
  <div class="fixed inset-0 pointer-events-none z-50 opacity-[0.03] bg-[linear-gradient(rgba(18,16,16,0)_50%,rgba(0,0,0,0.25)_50%),linear-gradient(90deg,rgba(255,0,0,0.06),rgba(0,255,0,0.02),rgba(0,0,255,0.06))] bg-[length:100%_2px,3px_100%]">
  </div>

  <div class="relative z-10 flex flex-col h-screen">
    <!-- Top HUD Bar (System Vitals) -->
    <header class="h-16 glass-panel border-b border-white/5 flex items-center justify-between px-6 shrink-0 z-40">
      <div class="flex items-center gap-6">
        <!-- Brand -->
        <div class="flex items-center gap-3 group cursor-pointer">
          <div class="relative w-10 h-10 flex items-center justify-center">
            <div class="absolute inset-0 bg-cyan-500/20 rounded-lg blur-sm group-hover:bg-cyan-500/30 transition-all">
            </div>
            <div class="relative bg-slate-950 border border-cyan-500/50 rounded-lg p-2">
              <svg
                class="w-5 h-5 text-cyan-400"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M13 10V3L4 14h7v7l9-11h-7z"
                />
              </svg>
            </div>
          </div>
          <div>
            <h1 class="text-lg font-bold tracking-wider text-white hologram-text">
              AEROPHOENIX
            </h1>
            <div class="flex items-center gap-2 text-[10px] uppercase tracking-widest text-cyan-500/80">
              <span>Orchestrator</span>
              <span class="w-1 h-1 rounded-full bg-cyan-500"></span>
              <span>v2.4.0</span>
            </div>
          </div>
        </div>
        
<!-- Global Metrics Ticker -->
        <div class="hidden lg:flex items-center gap-1 ml-8 border-l border-slate-200 dark:border-white/10 pl-8 transition-colors duration-300">
          <div class="flex flex-col items-center justify-center text-center px-4 border-r border-slate-200 dark:border-white/5 transition-colors duration-300">
            <span class="text-[10px] uppercase text-slate-500 tracking-wider">Global TPS</span>
            <span class="font-mono text-emerald-600 dark:text-emerald-400 font-bold transition-colors duration-300">
              12,450
            </span>
          </div>
          <div class="flex flex-col items-center justify-center text-center px-4 border-r border-slate-200 dark:border-white/5 transition-colors duration-300">
            <span class="text-[10px] uppercase text-slate-500 tracking-wider">Active Nodes</span>
            <span class="font-mono text-cyan-600 dark:text-cyan-400 font-bold transition-colors duration-300">
              {length(@machines)}
            </span>
          </div>
          <div class="flex flex-col items-center justify-center text-center px-4 border-r border-slate-200 dark:border-white/5 transition-colors duration-300">
            <span class="text-[10px] uppercase text-slate-500 tracking-wider">Migrations</span>
            <span class="font-mono text-violet-600 dark:text-violet-400 font-bold transition-colors duration-300">
              {length(@active_migrations)}
            </span>
          </div>
          <div class="flex flex-col items-center justify-center text-center px-4">
            <span class="text-[10px] uppercase text-slate-500 tracking-wider">System Status</span>
            <div class="flex items-center gap-2">
              <span class="relative flex h-2 w-2">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75">
                </span>
                <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
              </span>
              <span class="text-xs text-emerald-600 dark:text-emerald-400 font-medium transition-colors duration-300">
                OPTIMAL
              </span>
            </div>
          </div>
        </div>
      </div>
      
<!-- Right Controls -->
      <div class="flex items-center gap-4" phx-hook="ThemeSystem" id="theme-system">
        <button
          phx-click="refresh"
          class="p-2 rounded-lg hover:bg-white/5 text-slate-400 hover:text-white transition-colors"
        >
          <.icon name="hero-arrow-path" class="w-5 h-5" />
        </button>

        <div class="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-slate-900/50 border border-white/10">
          <div class="w-2 h-2 rounded-full bg-rose-500 animate-pulse"></div>
          <span class="text-xs font-mono text-rose-400">LIVE CONNECTION</span>
        </div>
        
<!-- Theme Switcher -->
        <PhoenixUiWeb.Layouts.theme_toggle />
      </div>
    </header>

    <div class="flex flex-1 overflow-hidden">
      <!-- Side Dock Navigation -->
      <nav class="w-20 glass-panel border-r border-white/5 flex flex-col items-center py-6 gap-4 z-30 shrink-0">
        <%= for tab <- @tabs do %>
          <button
            phx-click="switch_tab"
            phx-value-tab={tab.id}
            class="group relative w-12 h-12 flex items-center justify-center rounded-xl transition-all duration-300"
            title={tab.name}
          >
            <!-- Active Indicator -->
            <%= if @active_tab == tab.id do %>
              <div class="absolute inset-0 bg-gradient-to-br from-#{tab.color}-500/20 to-transparent rounded-xl border border-#{tab.color}-500/50 shadow-[0_0_15px_rgba(var(--color-#{tab.color}),0.3)]">
              </div>
              <div class="absolute left-0 top-1/2 -translate-y-1/2 w-1 h-6 bg-#{tab.color}-500 rounded-r-full shadow-[0_0_10px_#{tab.color}]">
              </div>
            <% end %>
            
<!-- Icon -->
            <div class={[
              "relative z-10 transition-transform duration-300 group-hover:scale-110",
              if(@active_tab == tab.id,
                do: "text-#{tab.color}-400",
                else: "text-slate-500 group-hover:text-slate-300"
              )
            ]}>
              <.icon name={tab.icon} class="w-6 h-6" />
            </div>
            
<!-- Tooltip -->
            <div class="absolute left-14 px-3 py-1.5 rounded-md bg-slate-900 border border-white/10 text-xs font-medium text-white opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none whitespace-nowrap z-50">
              {tab.name}
            </div>
          </button>
        <% end %>
      </nav>
      
<!-- Main Content Area -->
      <main class="flex-1 overflow-y-auto overflow-x-hidden relative scroll-smooth">
        <!-- Content Container -->
        <div class="p-6 lg:p-8 max-w-[1920px] mx-auto min-h-full">
          
<!-- Page Header -->
          <div class="mb-8 flex items-end justify-between animate-fade-in-up">
            <div>
              <h2 class="text-3xl font-bold text-white mb-2 flex items-center gap-3">
                <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-violet-400">
                  {Enum.find(@tabs, fn t -> t.id == @active_tab end) |> Map.get(:name)}
                </span>
                <div class="h-px flex-1 bg-gradient-to-r from-white/20 to-transparent w-32"></div>
              </h2>
              <p class="text-slate-400 max-w-2xl text-sm leading-relaxed">
                <%= case @active_tab do %>
                  <% "overview" -> %>
                    Real-time distributed systems orchestration and monitoring. Visualizing {length(
                      @machines
                    )} nodes across {length(@regions)} regions.
                  <% "migrations" -> %>
                    Live migration tracking with zero-downtime state transfer protocols.
                  <% "grpc" -> %>
                    gRPC service mesh health and performance metrics.
                  <% "topology" -> %>
                    Multi-region network topology visualization with latency heatmaps.
                  <% "fsm" -> %>
                    Finite state machine transitions and lifecycle management.
                  <% "cli" -> %>
                    Command-line interface builder and execution history.
                  <% "debugger" -> %>
                    Live debugging with process inspection and network capture.
                  <% "replay" -> %>
                    Event sourcing replay and state reconstruction.
                  <% "optimizer" -> %>
                    Cost and latency optimization with ML-powered recommendations.
                  <% "scaling" -> %>
                    Predictive auto-scaling with ARIMA forecasting.
                  <% "flags" -> %>
                    Feature flag management and A/B testing platform.
                <% end %>
              </p>
            </div>
            
<!-- Context Actions -->
            <div class="flex items-center gap-3">
              <%= if @active_tab == "overview" do %>
                <button class="px-4 py-2 rounded-lg bg-cyan-500/10 border border-cyan-500/50 text-cyan-400 hover:bg-cyan-500/20 transition-all flex items-center gap-2 text-sm font-medium">
                  <.icon name="hero-plus" class="w-4 h-4" />
                  <span>Provision Node</span>
                </button>
              <% end %>
            </div>
          </div>
          
<!-- Tab Content -->
          <div class="animate-fade-in-up animation-delay-200">
            <%= case @active_tab do %>
              <% "overview" -> %>
                <div class="grid grid-cols-12 gap-6">
                  <!-- Main Topology Map (Spans 8 cols) -->
                  <div class="col-span-12 lg:col-span-8 space-y-6">
                    <div class="hud-card min-h-[600px] relative group">
                      <div class="absolute top-0 right-0 p-4 z-10 flex gap-2">
                        <div class="px-2 py-1 rounded bg-black/50 border border-white/10 text-[10px] text-cyan-400 font-mono">
                          LIVE MAP
                        </div>
                      </div>
                      <PhoenixUiWeb.TopologyComponent.render
                        regions={@regions}
                        machines={@machines}
                        active_chaos={@active_chaos}
                      />
                    </div>

                    <PhoenixUiWeb.CreateMachineForm.render regions={@regions} />
                  </div>
                  
<!-- Right Sidebar (Spans 4 cols) -->
                  <div class="col-span-12 lg:col-span-4 space-y-6">
                    <PhoenixUiWeb.MachineCardEnhanced.render machine={@selected} />

                    <PhoenixUiWeb.ChaosPanelComponent.render
                      active_chaos={@active_chaos}
                      chaos_logs={@chaos_logs}
                    />

                    <%= if @chaos_logs != [] do %>
                      <div class="hud-card">
                        <div class="flex items-center justify-between mb-3">
                          <span class="hud-label text-amber-500">Chaos Logs</span>
                          <span class="text-[10px] px-2 py-0.5 rounded-full bg-amber-500/10 text-amber-500 border border-amber-500/20">
                            {length(@chaos_logs)} EVENTS
                          </span>
                        </div>
                        <div class="h-48 overflow-y-auto space-y-2 font-mono text-xs pr-2 custom-scrollbar">
                          <%= for log <- Enum.take(@chaos_logs, 20) do %>
                            <div class="flex gap-2 text-slate-400 border-l-2 border-amber-500/30 pl-2 py-1">
                              <span class="text-slate-600 shrink-0">
                                {String.slice(log.timestamp, 11, 8)}
                              </span>
                              <span class={
                                if log.level == "warning",
                                  do: "text-amber-400",
                                  else: "text-slate-300"
                              }>
                                {log.message}
                              </span>
                            </div>
                          <% end %>
                        </div>
                      </div>
                    <% end %>

                    <PhoenixUiWeb.PlannerPanelComponent.render
                      selected_machine={@selected}
                      recommendations={@prediction || []}
                    />
                  </div>
                </div>
              <% "migrations" -> %>
                <.live_component
                  module={PhoenixUiWeb.MigrationPanelComponent}
                  id="migration-panel"
                  active_migrations={@active_migrations}
                  completed_migrations={@completed_migrations}
                  migration_stats={@migration_stats}
                />
              <% "grpc" -> %>
                <.live_component
                  module={PhoenixUiWeb.GrpcMonitorComponent}
                  id="grpc-monitor"
                  services={@grpc_services}
                  grpc_metrics={@grpc_metrics}
                  active_connections={@active_connections}
                  recent_errors={@recent_errors}
                  show_connections={@show_connections}
                  total_connections={@total_connections}
                />
              <% "topology" -> %>
                <div class="hud-card h-[80vh]">
                  <PhoenixUiWeb.TopologyComponent.render
                    regions={@regions}
                    machines={@machines}
                    active_chaos={@active_chaos}
                  />
                </div>
              <% "fsm" -> %>
                <.live_component
                  module={PhoenixUiWeb.FsmVisualizerComponent}
                  id="fsm-visualizer"
                  fsm_states={@fsm_states}
                  machines={@machines}
                  transition_history={@transition_history}
                  state_analytics={@state_analytics}
                />
              <% "cli" -> %>
                <.live_component
                  module={PhoenixUiWeb.CliBuilderComponent}
                  id="cli-builder"
                  command_history={@command_history}
                />
              <% "debugger" -> %>
                <.live_component
                  module={PhoenixUiWeb.LiveDebuggerComponent}
                  id="live-debugger"
                  debug_sessions={@debug_sessions}
                  machines={@machines}
                />
              <% "replay" -> %>
                <.live_component
                  module={PhoenixUiWeb.EventReplayComponent}
                  id="event-replay"
                />
              <% "optimizer" -> %>
                <.live_component
                  module={PhoenixUiWeb.OptimizerDashboardComponent}
                  id="optimizer-dashboard"
                  machines={@machines}
                  regions={@regions}
                />
              <% "scaling" -> %>
                <.live_component
                  module={PhoenixUiWeb.AutoscalingPanelComponent}
                  id="autoscaling-panel"
                  scaling_policies={@scaling_policies}
                  machines={@machines}
                />
              <% "flags" -> %>
                <div
                  class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"
                  phx-hook="FeatureFlags"
                  id="feature-flags"
                >
                  <%= for flag <- @feature_flags do %>
                    <div class="hud-card group hover:border-pink-500/50 transition-colors">
                      <div class="flex items-center justify-between mb-4">
                        <div class="flex items-center gap-3">
                          <div class="w-10 h-10 rounded-lg bg-pink-500/10 flex items-center justify-center border border-pink-500/20">
                            <.icon name="hero-flag" class="w-5 h-5 text-pink-400" />
                          </div>
                          <div>
                            <h4 class="font-bold text-white text-sm">{flag.name}</h4>
                            <span class="text-[10px] text-slate-500 uppercase tracking-wider">
                              Feature Flag
                            </span>
                          </div>
                        </div>
                        <button
                          phx-click="toggle_flag"
                          phx-value-flag_id={flag.id}
                          class={[
                            "relative inline-flex h-6 w-11 items-center rounded-full transition-colors focus:outline-none focus:ring-2 focus:ring-pink-500 focus:ring-offset-2 focus:ring-offset-slate-900",
                            if(flag.enabled, do: "bg-pink-600", else: "bg-slate-700")
                          ]}
                        >
                          <span class={[
                            "inline-block h-4 w-4 transform rounded-full bg-white transition-transform",
                            if(flag.enabled, do: "translate-x-6", else: "translate-x-1")
                          ]} />
                        </button>
                      </div>

                      <p class="text-sm text-slate-400 mb-6 h-10 line-clamp-2">
                        {flag.description}
                      </p>

                      <div class="space-y-2">
                        <div class="flex justify-between text-xs">
                          <span class="text-slate-500">Rollout</span>
                          <span class="text-pink-400 font-mono">{flag.rollout_percentage}%</span>
                        </div>
                        <div class="h-1.5 bg-slate-800 rounded-full overflow-hidden">
                          <div
                            class="h-full bg-gradient-to-r from-pink-500 to-purple-500"
                            style={"width: #{flag.rollout_percentage}%"}
                          >
                          </div>
                        </div>
                      </div>
                    </div>
                  <% end %>
                </div>
            <% end %>
          </div>
        </div>
      </main>
    </div>
    
<!-- Toast Container (Fixed Position) -->
    <ul
      id="toast-container"
      phx-hook="ToastHook"
      class="fixed top-20 right-6 z-50 flex flex-col gap-3 pointer-events-none"
    >
      <%= if Phoenix.Flash.get(@flash, :info) do %>
        <li class="pointer-events-auto glass-panel border-l-4 border-emerald-500 p-4 rounded-r-lg shadow-lg shadow-emerald-900/20 min-w-[300px] animate-slide-in-right flex items-center gap-3">
          <.icon name="hero-check-circle" class="w-5 h-5 text-emerald-400" />
          <p class="text-sm text-emerald-100">{Phoenix.Flash.get(@flash, :info)}</p>
        </li>
      <% end %>
      <%= if Phoenix.Flash.get(@flash, :error) do %>
        <li class="pointer-events-auto glass-panel border-l-4 border-rose-500 p-4 rounded-r-lg shadow-lg shadow-rose-900/20 min-w-[300px] animate-slide-in-right flex items-center gap-3">
          <.icon name="hero-exclamation-circle" class="w-5 h-5 text-rose-400" />
          <p class="text-sm text-rose-100">{Phoenix.Flash.get(@flash, :error)}</p>
        </li>
      <% end %>
    </ul>
    
<!-- Chaos Modal -->
    <%= if @chaos_modal_open do %>
      <div
        class="fixed inset-0 z-[100] flex items-center justify-center bg-slate-950/80 backdrop-blur-sm p-4"
        phx-click="close-chaos-modal"
      >
        <div
          phx-click="modal-content-click"
          class="glass-panel w-full max-w-lg rounded-2xl border border-rose-500/30 shadow-[0_0_50px_rgba(244,63,94,0.2)] animate-fade-in-up overflow-hidden"
        >
          <!-- Modal Header -->
          <div class="bg-rose-500/10 border-b border-rose-500/20 p-6 flex items-center justify-between">
            <div class="flex items-center gap-3">
              <div class="p-2 rounded-lg bg-rose-500/20 text-rose-400">
                <.icon name="hero-beaker" class="w-6 h-6" />
              </div>
              <div>
                <h3 class="text-lg font-bold text-white">Initiate Chaos</h3>
                <p class="text-xs text-rose-300 uppercase tracking-wider">
                  System Integrity Test
                </p>
              </div>
            </div>
            <button
              phx-click="close-chaos-modal"
              class="text-slate-400 hover:text-white transition-colors"
            >
              <.icon name="hero-x-mark" class="w-6 h-6" />
            </button>
          </div>
          
<!-- Modal Body -->
          <div class="p-6">
            <form phx-submit="submit-chaos" class="space-y-6">
              <div class="space-y-2">
                <label class="text-xs font-semibold text-slate-400 uppercase tracking-wider">
                  Chaos Type
                </label>
                <div class="grid grid-cols-2 gap-3">
                  <label class="cursor-pointer">
                    <input type="radio" name="kind" value="latency" class="peer sr-only" checked />
                    <div class="p-3 rounded-lg border border-slate-700 bg-slate-800/50 hover:bg-slate-800 peer-checked:border-rose-500 peer-checked:bg-rose-500/10 peer-checked:text-rose-400 transition-all flex items-center gap-2">
                      <.icon name="hero-clock" class="w-4 h-4" />
                      <span class="text-sm font-medium">Latency</span>
                    </div>
                  </label>
                  <label class="cursor-pointer">
                    <input type="radio" name="kind" value="packet_loss" class="peer sr-only" />
                    <div class="p-3 rounded-lg border border-slate-700 bg-slate-800/50 hover:bg-slate-800 peer-checked:border-rose-500 peer-checked:bg-rose-500/10 peer-checked:text-rose-400 transition-all flex items-center gap-2">
                      <.icon name="hero-wifi" class="w-4 h-4" />
                      <span class="text-sm font-medium">Packet Loss</span>
                    </div>
                  </label>
                  <label class="cursor-pointer">
                    <input type="radio" name="kind" value="cpu_spike" class="peer sr-only" />
                    <div class="p-3 rounded-lg border border-slate-700 bg-slate-800/50 hover:bg-slate-800 peer-checked:border-rose-500 peer-checked:bg-rose-500/10 peer-checked:text-rose-400 transition-all flex items-center gap-2">
                      <.icon name="hero-bolt" class="w-4 h-4" />
                      <span class="text-sm font-medium">CPU Spike</span>
                    </div>
                  </label>
                  <label class="cursor-pointer">
                    <input
                      type="radio"
                      name="kind"
                      value="network_partition"
                      class="peer sr-only"
                    />
                    <div class="p-3 rounded-lg border border-slate-700 bg-slate-800/50 hover:bg-slate-800 peer-checked:border-rose-500 peer-checked:bg-rose-500/10 peer-checked:text-rose-400 transition-all flex items-center gap-2">
                      <.icon name="hero-scissors" class="w-4 h-4" />
                      <span class="text-sm font-medium">Partition</span>
                    </div>
                  </label>
                </div>
              </div>

              <div class="space-y-2">
                <label class="text-xs font-semibold text-slate-400 uppercase tracking-wider">
                  Target Machine ID
                </label>
                <input
                  type="text"
                  name="target"
                  placeholder="Leave empty for random target"
                  value={@chaos_form["target"]}
                  class="w-full bg-slate-950 border border-slate-700 rounded-lg px-4 py-2.5 text-white focus:border-rose-500 focus:ring-1 focus:ring-rose-500 outline-none transition-all placeholder:text-slate-600"
                />
              </div>

              <div class="space-y-4">
                <div class="flex justify-between">
                  <label class="text-xs font-semibold text-slate-400 uppercase tracking-wider">
                    Severity
                  </label>
                  <span class="text-xs font-mono text-rose-400">HIGH INTENSITY</span>
                </div>
                <input
                  type="range"
                  name="severity"
                  min="0"
                  max="1"
                  step="0.1"
                  value={@chaos_form["severity"]}
                  class="w-full h-2 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-rose-500"
                />
              </div>

              <div class="pt-4 flex gap-3">
                <button
                  type="button"
                  phx-click="close-chaos-modal"
                  class="flex-1 px-4 py-2.5 rounded-lg border border-slate-700 text-slate-300 hover:bg-slate-800 transition-colors font-medium"
                >
                  Cancel
                </button>
                <button
                  type="submit"
                  class="flex-1 px-4 py-2.5 rounded-lg bg-gradient-to-r from-rose-600 to-red-600 hover:from-rose-500 hover:to-red-500 text-white font-bold shadow-lg shadow-rose-900/30 transition-all transform hover:scale-[1.02]"
                >
                  DEPLOY CHAOS
                </button>
              </div>
            </form>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
