# =============================================================================
# AeroPhoenix Orchestrator - Release Environment Configuration
# =============================================================================
# This file is executed at runtime when the release starts.
# =============================================================================

# Erlang VM configuration for Fly.io (IPv6 support)
export ERL_AFLAGS="-proto_dist inet6_tcp"

# Memory settings optimized for suspend mode
export ELIXIR_ERL_OPTIONS="+sbwt none +sbwtdcpu none +sbwtdio none"

# Process limit for handling many MachineActor processes
export ERL_FLAGS="+P 1000000 +hms 233 +hmbs 233"

# Cookie for distributed Erlang
if [ -z "${RELEASE_COOKIE:-}" ]; then
  export RELEASE_COOKIE="aerophoenix_orchestrator_cookie_${FLY_APP_NAME:-local}"
fi

# Node name for clustering
if [ -z "${RELEASE_NODE:-}" ]; then
  export RELEASE_NODE="orchestrator@${FLY_ALLOC_ID:-127.0.0.1}.vm.${FLY_APP_NAME:-orchestrator}.internal"
fi

# Distribution mode
export RELEASE_DISTRIBUTION="${RELEASE_DISTRIBUTION:-name}"

# IPv6 for Fly.io internal networking
export ECTO_IPV6="true"

# Ensure data directory exists
mkdir -p /app/data/machines
