# =============================================================================
# AeroPhoenix Docker Ignore
# =============================================================================
# Excludes files from Docker build context for faster builds
# =============================================================================

# Dependencies and build artifacts
_build/
deps/
node_modules/
.elixir_ls/
.hex/
.mix/

# Git
.git/
.gitignore

# IDE
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Test artifacts
cover/
test/
/tests/
*.test
*.spec.ts
*.spec.js

# Documentation
docs/
*.md
!README.md

# CI/CD
.github/
.circleci/
.travis.yml
Makefile

# Fly config (we use the ones in fly/ directory)
fly.toml

# Local development
*.local
.env*
docker-compose*.yml

# Runtime data
data/
tmp/
log/
logs/
*.log

# Compiled files
*.beam
*.ez
erl_crash.dump

# Native code artifacts
priv/native/

# Cargo (Rust)
target/

# Go
bin/


# Ignore Git history
.git
.gitignore

# Ignore Elixir/Phoenix artifacts
_build
deps
/apps/*/deps
/apps/*/_build
/apps/*/priv/static
erl_crash.dump

# Ignore Node/JS artifacts
node_modules
/apps/*/assets/node_modules
npm-debug.log

# Ignore OS files
.DS_Store
.check.exs
.credo.exs

# Ignore test artifacts
cover
/apps/*/cover
/apps/*/tmp

# Ignore local Fly configs (optional, but good practice)
fly/*
!fly/*/fly.toml
!fly/*/Dockerfile